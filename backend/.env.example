ANTHROPIC_API_KEY=
# Or call Claude through your Claude subscription instead (Claude Code's login; needs `uv sync --extra claude-code`).
# The API key above is then ignored.
# LLM_BACKEND=claude-code
# Only if your key isn't scoped to a workspace (the API then asks for an anthropic-workspace-id header):
# ANTHROPIC_CUSTOM_HEADERS="anthropic-workspace-id: wrkspc_..."
# Optional, raises Semantic Scholar rate limits
S2_API_KEY=
# Optional, to compare speed/quality for header extraction and page notes (defaults: claude-opus-5-5, low)
# EXTRACT_MODEL=claude-sonnet-5-5
# EXTRACT_EFFORT=medium
# SUMMARY_MODEL=claude-opus-5-5
# SUMMARY_EFFORT=low
# TUTOR_MODEL=claude-opus-5-5
# TUTOR_EFFORT=medium
# ABSTRACT_MODEL=claude-opus-5-5
# ABSTRACT_EFFORT=medium
# QUIZ_MODEL=claude-opus-5-5
# QUIZ_EFFORT=low
# PROOF_MODEL=claude-opus-5-5
# PROOF_EFFORT=low
# Optional, the arXiv categories the For you tab follows (space-separated; default astro-ph.CO)
# FEED_CATEGORIES=astro-ph.CO gr-qc
