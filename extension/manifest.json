{
  "manifest_version": 3,
  "name": "HLRF",
  "version": "0.1.0",
  "description": "Save a paper to read it in the HLRF library.",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "dist/background.js"
  }
}
